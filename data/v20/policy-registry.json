    "indicatorMethodology": {
      "sma": "trusted closes only",
      "ema": "SMA seed then standard EMA multiplier",
      "rsi14": "Wilder smoothing",
      "atr14": "Wilder true range using trusted OHLC and prior close",
      "macd": "EMA12 minus EMA26 with EMA9 signal",
